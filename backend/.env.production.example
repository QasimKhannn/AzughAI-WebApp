# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database Configuration
DATABASE_NAME=azughai_db
DATABASE_USER=azughai_user
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=db
DATABASE_PORT=3306

# Optional: SSL Path for Azure MySQL (uncomment if needed)
# SSL_PATH=DigiCertGlobalRootG2.crt.pem

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# Testing & Development
TEST_MODE=False
PRELOAD_EMBEDDER=True
VECTOR_DB_LOCAL_MODE=True
